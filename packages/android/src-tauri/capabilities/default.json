{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Android",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "haptics:default",
    "notification:default",
    "opener:default",
    "store:default",
    "mobile-bridge:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*/**"
        },
        {
          "url": "https://*/**"
        }
      ]
    }
  ]
}
